#: src/font-installer.sh:18
msgid "You need to provide a file!"
msgstr "আপনাকে একটি ফাইল দিতে হবে!"

#: src/font-installer.sh:25
msgid "Font Installer"
msgstr "ফন্ট ইনস্টলার"

#. Translators: yad button label (generic confirmation).
#: src/font-installer.sh:27
msgid "OK"
msgstr "ঠিক আছে"

#: src/font-installer.sh:32
#, sh-format
msgid "The file '$font_file' is not a valid font file!"
msgstr "'$font_file' ফাইলটি কোনো বৈধ ফন্ট ফাইল নয়!"

#. Translators: sample text rendered with the font being previewed. Use a short
#. pangram (a sentence containing every letter) or a short typical sentence in
#. your language, so users can judge how the font renders it.
#: src/font-installer.sh:46
msgid "The quick brown fox jumps over the lazy dog"
msgstr "চটপট খয়েরী শিয়ালটি লাফ দেয় অলস কুকুরের উপর"

#: src/font-installer.sh:50
msgid "Cancel"
msgstr "বাতিল করুন"

#: src/font-installer.sh:50
msgid "Family:"
msgstr "ফ্যামিলি:"

#: src/font-installer.sh:50
#, sh-format
msgid "Font Installer - $base_name"
msgstr "ফন্ট ইনস্টলার - $base_name"

#: src/font-installer.sh:50
msgid "Foundry:"
msgstr "ফাউন্ড্রি:"

#: src/font-installer.sh:50
msgid "Install"
msgstr "ইনস্টল করুন"

#. Translators: field labels of the font details form; keep the trailing colon.
#: src/font-installer.sh:50
msgid "Name:"
msgstr "নাম:"

#: src/font-installer.sh:50
msgid "Style:"
msgstr "স্টাইল:"

#: src/font-installer.sh:50
msgid "Type:"
msgstr "ধরন:"

#: src/font-installer.sh:54
msgid "The font could not be installed."
msgstr "ফন্টটি ইনস্টল করা যায়নি।"

#: src/font-installer.sh:60
#, sh-format
msgid "Installing the font $font_name $font_style"
msgstr "$font_name $font_style ফন্টটি ইনস্টল করা হচ্ছে"

#: src/font-installer.sh:62
msgid "The installation was successful!"
msgstr "ইনস্টলেশন সফল হয়েছে!"

#: src/launcher.desktop.in:4
msgid "Install Font"
msgstr "ফন্ট ইনস্টল করুন"
